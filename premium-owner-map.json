      "body": "function slots(){refreshAudioTableContext('roster-change');$('slots').innerHTML='';for(let i=1;i<=8;i++){let p=players.find(x=>x.id===i),d=document.createElement('div');d.className='slot';let left=document.createElement('div');left.className='slotName';let nm=document.createElement('span');nm.textContent=p?(p.name||('Player '+i)):('Player '+i);left.appendChild(nm);if(p&&i!==1){let sub=document.createElement('span');sub.className='slotSub';sub.textContent=(p.connected===false?'SLOT '+i+' \u00b7 RECONNECT RESERVED':'SLOT '+i)+(p.commander?' \u00b7 '+p.commander:'');left.appendChild(sub)}let right=document.createElement('div');right.className='slotActions';let stx=document.createElement('span');stx.className=p&&p.r?'ready':'';stx.textContent=p?(p.connected===false?'OFFLINE':(p.r?'READY':'CONNECTED')):'OPEN';right.appendChild(stx);if(HST&&p&&i!==1){let k=document.createElement('button');k.className='kickBtn';k.textContent='KICK';k.onclick=()=>kickPlayer(i);right.appendChild(k)}d.append(left,right);$('slots').append(d)}updateLobbyStatus()}function phase108Outbound(m,{advance=true,lobbyAdvance=true}={}){if(!HST||typeof MTGAuthoritativeSync==='undefined'||!m)return m;let x=m;if(['state','start'].includes(String(x.t||''))&&x.st){if(advance)authoritySyncRevision=MTGAuthoritativeSync.nextRevision(Math.max(authoritySyncRevision,MTGAuthoritativeSync.stateRevision(st)));x=MTGAuthoritativeSync.stampStateMessage(x,{revision:authoritySyncRevision,epoch:Number(roomDescriptor?.epoch||1),reason:x.t});}else if(['welcome','resume_state'].includes(String(x.t||''))&&x.st){if(!authoritySyncRevision)authoritySyncRevision=Math.max(1,MTGAuthoritativeSync.stateRevision(st));x=MTGAuthoritativeSync.stampStateMessage(x,{revision:authoritySyncRevision,epoch:Number(roomDescriptor?.epoch||1),reason:x.t});}if(x.players&&['players','welcome','resume_state','start'].includes(String(x.t||''))){if(x.t==='players'&&lobbyAdvance)authorityLobbyRevision=MTGAuthoritativeSync.nextRevision(authorityLobbyRevision);x=MTGAuthoritativeSync.stampPlayersMessage(x,{revision:authorityLobbyRevision});}return x}\nlet sharedDisplayRealtimeGate=null,sharedDisplayRealtimeReason='state-mutation';\n"
    },
