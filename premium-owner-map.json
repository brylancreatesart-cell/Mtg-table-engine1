      "body": "function introRosterHtml(){return players.filter(p=>p.connected!==false).map(p=>'<div class=\"battleIntroPlayer\"><div class=\"battleIntroAvatar\">'+rosterAvatar(p)+'</div><div><div class=\"battleIntroName\">'+(p.name||('Player '+p.id))+'</div><div class=\"battleIntroCmd\">'+(p.commander||'No commander')+(p.deckName?' \u00b7 '+p.deckName:'')+'</div></div></div>').join('')}\nlet introTimer=null,introDone=null;function finishBattleIntro(){clearTimeout(introTimer);$('battleIntro').classList.remove('on');$('battleIntro').classList.add('h');$('battleIntro').setAttribute('aria-hidden','true');showBattlePage();hud();sync();$('bt').classList.add('on');setTimeout(()=>$('bt').classList.remove('on'),950);stopLobbyAmbience();cue('battle');feed('All combatants were ready. The battle began.');if(introDone){let fn=introDone;introDone=null;fn()}}\n"
    },
    "playBattleIntro": {
      "file": "scripts/app-src/controller-part-05.part.js",
      "line": 1,
      "body": "function playBattleIntro(done){introDone=done||null;let ov=$('battleIntro');$('setup').classList.add('h');$('lobby').classList.add('h');$('game').classList.add('h');$('hostControl').classList.add('h');$('battleIntroRoster').innerHTML=introRosterHtml();$('battleIntroCall').textContent='All combatants are ready.';$('battleIntroFinal').classList.remove('show');ov.classList.remove('h');ov.setAttribute('aria-hidden','false');requestAnimationFrame(()=>ov.classList.add('on'));MTGAnnouncerEngine.event('battleEntry',{});setTimeout(()=>{$('battleIntroCall').textContent='The battlefield waits.'},1250);setTimeout(()=>{$('battleIntroFinal').classList.add('show');$('battleIntroCall').textContent='';MTGAnnouncerEngine.event('battleStart',{force:true})},2300);introTimer=setTimeout(finishBattleIntro,3600)}\n$('battleIntroSkip').onclick=finishBattleIntro;\n"
    },
    "renderDeckAdaptiveHud": {
      "file": "scripts/app-src/controller-part-05.part.js",
      "line": 10,
      "body": "function renderDeckAdaptiveHud(){let mount=$('deckAdaptiveSummary');if(!mount)return;if(!hudFlags.deckAdaptiveHud||typeof MTGDeckAdaptiveHUD==='undefined'||!(prof.cards||[]).length){mount.innerHTML='';mount.classList.add('h');return}let dna=MTGDeckAdaptiveHUD.build(prof,st,me);mount.classList.remove('h');let deckName=currentSavedDeck()?.name||prof.commander||'Loaded Deck',chips=dna.tags.length?dna.tags.map(x=>'<span class=\"deckDNAChip\"><b>'+esc(x.label)+'</b>'+(x.count?' \u00b7 '+x.count+' card'+(x.count===1?'':'s'):'')+'</span>').join(''):'<span class=\"deckDNAChip\">GENERAL</span>';let ranked=(typeof MTGQuickActions!=='undefined'?MTGQuickActions.rank({profile:prof,state:st,playerId:me,limit:8}):[]),byKind=new Map(ranked.map(x=>[x.kind,x])),actions=dna.primary.map(x=>byKind.get(x.kind)||{label:x.action,kind:x.kind,reasons:['loaded deck uses this mechanic']}).slice(0,4);if(!actions.length)actions=[{label:'Add Manual Permanent',kind:'manual',reasons:['universal physical-table fallback']}];mount.innerHTML='<div class=\"deckAdaptiveSummary\"><div class=\"deckAdaptiveTop\"><div><div class=\"deckAdaptiveName\">'+esc(deckName.toUpperCase())+' \u00b7 DECK DNA</div><div class=\"deckAdaptivePrivate\">PRIVATE \u00b7 GENERATED FROM YOUR LOADED LIST</div></div><span class=\"pill\">'+dna.cardCount+' CARDS</span></div><div class=\"deckDNA\">'+chips+'</div><div class=\"deckAdaptiveActions\">'+actions.map((a,i)=>'<button class=\"deckAdaptiveAction\" data-adaptive-action=\"'+i+'\"><b>'+esc(a.label)+'</b><small>'+esc((a.reasons||[]).at(-1)||'deck-matched shortcut')+'</small></button>').join('')+'</div>'+(dna.counterTypes.length?'<div class=\"small\" style=\"margin-top:7px\">TRACKED COUNTERS \u00b7 '+dna.counterTypes.map(esc).join(' \u00b7 ')+'</div>':'')+'<button class=\"deckAdaptiveFallback\" id=\"deckAdaptiveAll\">SHOW ALL DECK TOOLS</button></div>';mount.querySelectorAll('[data-adaptive-action]').forEach(b=>b.onclick=()=>{let a=actions[Number(b.dataset.adaptiveAction)];executeRankedQuickAction(a)});let all=$('deckAdaptiveAll');if(all)all.onclick=quickActionMenu;}\n"
    },
    "hud": {
      "file": "scripts/app-src/controller-part-06.part.js",
      "line": 12,
      "body": "function hud(){let p=players.find(x=>x.id===me),nm=p?.name||playerProfile?.name||('Player '+me),cm=p?.commander||commanderName()||'NO COMMANDER';$('hudName').textContent=nm;$('hudAvatar').innerHTML=avatarMarkup(playerProfile?.avatarId||MTGAvatars.DEFAULT_ID);$('battleCommander').textContent=cm;renderResourceRail();renderDeckAdaptiveHud();$('mods').innerHTML=hudFlags.deckAdaptiveHud?'':prof.mods.map(m=>'<div class=\"mod\"><b>'+m[0]+'</b><div class=\"acts\">'+m[1].map(a=>'<button class=\"act\">'+a+'</button>').join('')+'</div></div>').join('');$('mods').querySelectorAll('.act').forEach(b=>b.onclick=()=>action(b.textContent));$('life').onclick=()=>{let cur=st.life[me]??40,raw=prompt('Set Life',String(cur));if(raw===null)return;let d=MTGPlayerHUD?.directDelta?MTGPlayerHUD.directDelta(cur,raw):Number(raw)-Number(cur);if(d===null||!Number.isFinite(Number(d)))return toast('Enter a number.');if(Number(d)!==0)cmd('life',{d:Number(d)})};bindHoldDelta($('lifeMinus'),()=>cmd('life',{d:-1}));bindHoldDelta($('lifePlus'),()=>cmd('life',{d:1}));$('hudWakeBtn').onclick=()=>wakePlayerHud(30000);if($('arrangeOpponentsBtn'))$('arrangeOpponentsBtn').onclick=arrangeOpponents;refreshSpatialSeatMap();refreshContextHud()}\n"
