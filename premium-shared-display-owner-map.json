  "js": {
    "showSharedDisplayPage": {
      "file": "scripts/app-src/controller-part-04.part.js",
      "line": 114,
      "body": "function showSharedDisplayPage(){sharedDisplayMode=true;document.body.classList.add('sharedTableDisplayMode');$('accountOverlay')?.classList.add('h');$('setup')?.classList.add('h');$('lobby')?.classList.add('h');$('game')?.classList.add('h');$('hostControl')?.classList.add('h');$('sharedDisplay')?.classList.remove('h');if(location.hash!=='#display')history.replaceState(null,'',location.pathname+location.search+'#display');requestSharedDisplayWakeLock();queueSharedDisplayOrientationSync()}\nasync function requestSharedDisplayWakeLock(){if(!sharedDisplayMode||!navigator.wakeLock?.request||sharedDisplayWakeLock)return;try{sharedDisplayWakeLock=await navigator.wakeLock.request('screen');sharedDisplayWakeLock.addEventListener?.('release',()=>{sharedDisplayWakeLock=null})}catch{}}\nlet sharedDisplayOrientationSyncTimer=null;\n"
    },
    "sharedDisplayPlayerHtml": {
      "file": "scripts/app-src/controller-part-04.part.js",
      "line": 122,
      "body": "function sharedDisplayPlayerHtml(p){let avatar=avatarMarkup(p.avatarId||MTGAvatars.DEFAULT_ID,{compact:true}),cls='sharedPlayerCard'+(p.active?' active':'')+(p.priority?' priority':'')+(p.fallen?' fallen':'');let stateLabel=p.fallen?'FALLEN':p.active?'ACTIVE PLAYER':p.priority?'PRIORITY':p.connected?'CONNECTED':'OFFLINE';return '<article class=\"'+cls+'\"><div class=\"sharedDisplayAvatar\">'+avatar+'</div><div class=\"sharedDisplayIdentity\"><b>'+esc(p.name||('Player '+p.id))+'</b><span>'+esc(p.commander||p.deckName||('PLAYER '+p.id))+' \u00b7 '+esc(stateLabel)+'</span></div><div class=\"sharedDisplayLife\"><b>'+esc(p.life)+'</b><span>LIFE</span></div><div class=\"sharedDisplayPublic\"><div class=\"sharedDisplayStat\"><b>'+esc(p.poison)+'</b><span>POISON</span></div><div class=\"sharedDisplayStat\"><b>'+esc(p.commanderDamage)+'</b><span>CMD MAX</span></div><div class=\"sharedDisplayStat\"><b>'+esc(p.permanents)+'</b><span>FIELD</span></div><div class=\"sharedDisplayStat\"><b>'+esc(p.lands)+'</b><span>LANDS</span></div><div class=\"sharedDisplayStat\"><b>'+esc(p.library)+'</b><span>LIBRARY</span></div><div class=\"sharedDisplayStat\"><b>'+esc(p.graveyard)+'</b><span>GRAVE</span></div></div></article>'}\n"
    },
    "renderSharedDisplay": {
      "file": "scripts/app-src/controller-part-04.part.js",
      "line": 123,
      "body": "function renderSharedDisplay(){if(!sharedDisplayMode||!$('sharedDisplay'))return;showSharedDisplayPage();let s=st?.sharedDisplay||(typeof MTGSharedDisplay!=='undefined'?MTGSharedDisplay.summary(st,players):null);if(!s)return;let ps=Array.isArray(s.players)?s.players:[];$('sharedDisplayJoin').classList.toggle('h',!!activeRoom);$('sharedDisplayStage').classList.toggle('h',!activeRoom);let active=ps.find(p=>p.id===s.active),priority=ps.find(p=>p.id===s.priority);$('sharedDisplayTurnMain').textContent=s.started?(s.battleName||'THE BATTLE BEGINS'):'LOBBY \u00b7 WAITING FOR BATTLE';$('sharedDisplayTurnSub').textContent=s.started?('TURN '+Number(s.turn||1)+' \u00b7 '+String(s.phase||'').toUpperCase()+' \u00b7 '+(active?.name||('Player '+s.active))+' ACTIVE'+(priority?' \u00b7 '+priority.name+' HAS PRIORITY':'')):(ps.filter(p=>p.ready).length+' / '+ps.length+' READY');$('sharedDisplayLeftState').textContent=s.monarch?('MONARCH \u00b7 '+(ps.find(p=>p.id===s.monarch)?.name||('P'+s.monarch))):'PUBLIC MATCH STATE';$('sharedDisplayRightState').textContent=s.initiative?('INITIATIVE \u00b7 '+(ps.find(p=>p.id===s.initiative)?.name||('P'+s.initiative))):'READ ONLY';let pm=$('sharedDisplayPlayers');pm.dataset.count=String(ps.length);pm.style.setProperty('--shared-cols',ps.length<=2?'2':ps.length<=4?'2':'4');pm.innerHTML=ps.length?ps.map(sharedDisplayPlayerHtml).join(''):'<div class=\"sharedDisplayEmpty\">Waiting for players to join the room.</div>';$('sharedDisplayStack').innerHTML=s.stack?.length?s.stack.map((x,i)=>'<div class=\"sharedDisplayStackLine\"><span>'+esc(x.name||'Stack object')+'</span><strong>'+(i===0?'TOP':'#'+(i+1))+'</strong></div>').join(''):'<div class=\"sharedDisplayEmpty\">Stack is clear.</div>';$('sharedDisplayEvent').textContent=s.latestEvent||'Waiting for the next public table event.';requestSharedDisplayWakeLock()}\n"
    }
  }
